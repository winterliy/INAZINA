{
  "name": "@inazina/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 --test-force-exit src/*.test.ts src/oidc/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/oidc-provider": "9.13.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jose": "6.2.18",
    "oidc-provider": "9.15.1"
  }
}
