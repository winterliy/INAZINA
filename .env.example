# Discord OAuth2 app credentials (the redirect address is the login server's, see below).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Keep this stable to preserve login sessions across API restarts.
INAZINA_AUTH_SECRET=

# Discord bot token used by run.py when starting all local services.
INAZINA_TOKEN=

# Maximum concurrent requests handled by the local Python data service.
INAZINA_MAX_HTTP_THREADS=16

# Coalesce identical portfolio/order reads for this many seconds.
INAZINA_READ_CACHE_SECONDS=0.25

# Single sign-on (docs/sso.md). Names are <service>.inazina.localhost; login, register and password reset exist only at id.<domain>.
INAZINA_OIDC_ISSUER=https://id.inazina.localhost/oidc
# INAZINA_DOMAIN=inazina.localhost
# Serve the built screens from Caddy instead of the Vite development servers (npm run build runs at start):
# INAZINA_FRONTEND=static
# INAZINA_WL=off   # turn the wiki viewer (wl.<domain>) off
# Visitors without an account (HTS market data): requests per minute and address. Default 240.
# INAZINA_GUEST_RATE_PER_MINUTE=240
# Discord proves who owns an account (register / reset). Its callback is derived from the issuer:
#   <issuer address>/oidc/account/discord/callback   (add it in the Discord Developer Portal > OAuth2 > Redirects)
# Node must trust Caddy's local certificate: cat /etc/ssl/cert.pem <Caddy root.crt> > ~/.inazina-ca.pem, then
# NODE_EXTRA_CA_CERTS=/Users/<you>/.inazina-ca.pem
