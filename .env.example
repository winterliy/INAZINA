# Discord OAuth2 app credentials. Register the redirect URI in the Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:4312/api/auth/discord/callback

# Keep this stable to preserve login sessions across API restarts.
INAZINA_AUTH_SECRET=

# Discord bot token used by run.py when starting all local services.
INAZINA_TOKEN=

# Maximum concurrent requests handled by the local Python data service.
INAZINA_MAX_HTTP_THREADS=16

# Coalesce identical portfolio/order reads for this many seconds.
INAZINA_READ_CACHE_SECONDS=0.25

# Single sign-on (docs/sso.md). Leave INAZINA_OIDC_ISSUER empty to keep the old per-app password login.
# INAZINA_OIDC_ISSUER=https://id.inazina.localhost/oidc
# INAZINA_DOMAIN=inazina.localhost
# WL_DOMAIN=wl.kr.localhost
# INAZINA_TLS=internal
# INAZINA_COOKIE_SECURE=true
# With single sign-on, register / password reset use Discord through the login server; its callback is derived from the issuer:
#   <issuer address>/oidc/account/discord/callback  -> add it in the Discord Developer Portal (OAuth2 > Redirects).
# DISCORD_REDIRECT_URI above is only for the old in-app flow (single sign-on off).
# Node must trust Caddy's local certificate: cat /etc/ssl/cert.pem <Caddy root.crt> > ~/.inazina-ca.pem, then (docs/sso.md)
# NODE_EXTRA_CA_CERTS=/Users/<you>/.inazina-ca.pem

# Requests per minute and address for visitors without an account (HTS market data). Default 240.
# INAZINA_GUEST_RATE_PER_MINUTE=240
