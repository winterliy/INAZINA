# INAZINA public edge. api.<domain> and port 4313 (internal gateway) are
# intentionally NOT published here.
# Env: INAZINA_FRONTEND (dev | static), INAZINA_ROOT (project folder, for static), INAZINA_WL (proxy | off),
#      INAZINA_DOMAIN (default inazina.localhost), WL_DOMAIN (default wl.kr.localhost; production: wl.kr),
#      INAZINA_TLS ("internal" locally, empty or unset in production).

# Certificates: INAZINA_TLS=internal uses Caddy's own local certificates (development); empty or unset leaves Caddy's
# automatic HTTPS on, which gets public certificates for the real domains (they must resolve to this machine, ports 80/443 open).
(tls_internal) {
	tls internal
}
(tls_public) {
	tls {
		protocols tls1.2 tls1.3
	}
}
# INAZINA_TLS set but empty (a bare `INAZINA_TLS=` line in .env) means the same as unset.
(tls_) {
	import tls_public
}

# The screens (naru, console, the site). INAZINA_FRONTEND=dev (default) proxies to the Vite development servers; `static`
# serves the built files (apps/<app>/dist from `npm run build`) from Caddy itself, which is what belongs on the internet:
# a development server is not made for visitors. The API is reached through /api/* either way.
(frontend_dev) {
	reverse_proxy 127.0.0.1:{args[0]}
}
(frontend_static) {
	root * {args[1]}
	encode zstd gzip
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
# INAZINA_FRONTEND set but empty means the same as unset.
(frontend_) {
	import frontend_dev {args[0]} {args[1]}
}

# The wiki viewer (wl.kr): its server part (entry password, file reads) exists only inside Vite, so it cannot be built into
# static files. INAZINA_WL=proxy (default in development) publishes that dev server; start_all sets `off` in static mode.
(wl_proxy) {
	reverse_proxy 127.0.0.1:4315
}
(wl_off) {
	respond "Not published." 404
}
(wl_) {
	import wl_proxy
}

(common) {
	import tls_{$INAZINA_TLS:public}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	redir https://www.{$INAZINA_DOMAIN:inazina.localhost}{uri} permanent
}

www.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	# The contact / report form is the only thing the site asks the API for.
	@feedback path /api/site/feedback
	handle @feedback {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		import frontend_{$INAZINA_FRONTEND:dev} 4314 {$INAZINA_ROOT:.}/apps/site/dist
	}
}

corp.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	# The contact / report form is the only thing the site asks the API for.
	@feedback path /api/site/feedback
	handle @feedback {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		import frontend_{$INAZINA_FRONTEND:dev} 4314 {$INAZINA_ROOT:.}/apps/site/dist
	}
}

# Identity provider: only the OIDC and account pages are reachable.
id.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@idpaths path /oidc/* /login /register /reset
	handle @idpaths {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		respond 404
	}
}

naru.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@internal path /api/internal*
	handle @internal {
		respond 404
	}
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		import frontend_{$INAZINA_FRONTEND:dev} 4311 {$INAZINA_ROOT:.}/apps/hts/dist
	}
}

console.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@internal path /api/internal*
	handle @internal {
		respond 404
	}
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		import frontend_{$INAZINA_FRONTEND:dev} 4310 {$INAZINA_ROOT:.}/apps/dashboard/dist
	}
}

# A separate domain with its own entry password; not part of the SSO.
{$WL_DOMAIN:wl.kr.localhost} {
	import common
	import wl_{$INAZINA_WL:proxy}
}

