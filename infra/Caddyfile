# INAZINA public edge. api.<domain> and port 4313 (internal gateway) are
# intentionally NOT published here.
# Env: INAZINA_DOMAIN (default inazina.localhost), WL_DOMAIN (default wl.kr.localhost; production: wl.kr),
#      INAZINA_TLS ("internal" locally, empty in production).

(common) {
	tls {$INAZINA_TLS}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	redir https://www.{$INAZINA_DOMAIN:inazina.localhost}{uri} permanent
}

www.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	reverse_proxy 127.0.0.1:4314
}

corp.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	reverse_proxy 127.0.0.1:4314
}

# Identity provider: only the OIDC and account pages are reachable.
id.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@idpaths path /oidc/* /login /register /reset
	handle @idpaths {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		respond 404
	}
}

naru.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@internal path /api/internal*
	handle @internal {
		respond 404
	}
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		reverse_proxy 127.0.0.1:4311
	}
}

console.{$INAZINA_DOMAIN:inazina.localhost} {
	import common
	@internal path /api/internal*
	handle @internal {
		respond 404
	}
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4312
	}
	handle {
		reverse_proxy 127.0.0.1:4310
	}
}

# A separate domain with its own entry password; not part of the SSO.
{$WL_DOMAIN:wl.kr.localhost} {
	import common
	reverse_proxy 127.0.0.1:4315
}

