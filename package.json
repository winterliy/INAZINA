{
  "name": "inazina-local-web",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace @inazina/dashboard",
    "dev:hts": "npm run dev --workspace @inazina/hts",
    "dev:site": "npm run dev --workspace @inazina/site",
    "dev:api": "npm run dev --workspace @inazina/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:wl": "npm run dev --workspace @inazina/wl",
    "test:wl": "node --import tsx --test apps/wl/src/wlmd.test.ts apps/wl/src/settings.test.ts",
    "test:hts": "cd apps/hts && TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test src/PriceChart.test.tsx src/chartScale.test.ts",
    "geoip:update": ".venv/bin/python tools/update_geoip.py"
  },
  "engines": {
    "node": ">=24"
  }
}
